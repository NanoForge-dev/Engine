{
  "$schema": "https://raw.githubusercontent.com/NanoForge-dev/actions/v3/schema/nanoforge.schema.json",
  "groups": [
    {
      "name": "engine",
      "packages": [
        "@nanoforge-dev/asset",
        "@nanoforge-dev/common",
        "@nanoforge-dev/core",
        "@nanoforge-dev/ecs",
        "@nanoforge-dev/editor-lib",
        "@nanoforge-dev/env",
        "@nanoforge-dev/graphics-2d",
        "@nanoforge-dev/graphics-3d",
        "@nanoforge-dev/input",
        "@nanoforge-dev/music",
        "@nanoforge-dev/network",
        "@nanoforge-dev/scene",
        "@nanoforge-dev/sound"
      ],
      "mode": "all",
      "versioning": "shared",
      "branchFormat": "releases/nanoforge@{version}",
      "commitFormat": "chore: release @nanoforge-dev/engine@{version}"
    },
    {
      "name": "utils",
      "packages": ["@nanoforge-dev/utils-eslint-config", "@nanoforge-dev/utils-prettier-config"],
      "mode": "single",
      "versioning": "independent"
    }
  ],
  "docs": { "category": "engine", "references": true }
}
