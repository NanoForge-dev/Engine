{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@nanoforge-dev/graphics-3d",
  "version": "0.0.0",
  "description": "NanoForge Engine - Graphics 3D",
  "keywords": [
    "nanoforge",
    "game",
    "engine"
  ],
  "homepage": "https://github.com/NanoForge-dev/Engine#readme",
  "bugs": "https://github.com/NanoForge-dev/Engine/issues",
  "license": "MIT",
  "contributors": [
    "Exelo <contact@exelo.dev>",
    "Fexkoser <martin.fillon@epitech.eu>",
    "Harper <timothe.jacquot@epitech.eu>",
    "Josephine <josephine.chicouras@epitech.eu>",
    "Leo <leo.outmizguine@epitech.eu>"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./three": {
      "require": {
        "types": "./dist/three.d.cts",
        "default": "./dist/three.cjs"
      },
      "import": {
        "types": "./dist/three.d.ts",
        "default": "./dist/three.js"
      }
    },
    "./three/tsl": {
      "require": {
        "types": "./dist/three-tsl.d.cts",
        "default": "./dist/three-tsl.cjs"
      },
      "import": {
        "types": "./dist/three-tsl.d.ts",
        "default": "./dist/three-tsl.js"
      }
    },
    "./package.json": "./package.json"
  },
  "type": "module",
  "directories": {
    "lib": "src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NanoForge-dev/Engine.git",
    "directory": "modules/graphics-3d"
  },
  "funding": "https://github.com/NanoForge-dev/Engine?sponsor",
  "scripts": {
    "build": "tsc --noEmit && tsdown --config-loader unrun",
    "lint": "prettier --check . && eslint --format=pretty src",
    "format": "prettier --write . && eslint --fix --format=pretty src",
    "test:unit": "vitest run --config ../../vitest.config.ts",
    "prepack": "pnpm run build && pnpm run lint",
    "changelog": "git cliff --prepend ./CHANGELOG.md -u -c ./cliff.toml -r ../../ --include-path 'modules/graphics-3d/*'",
    "release": "cliff-jumper"
  },
  "dependencies": {
    "@nanoforge-dev/common": "workspace:*",
    "@types/three": "catalog:graphics"
  },
  "peerDependencies": {
    "@nanoforge-dev/editor-lib": "workspace:*",
    "three": "catalog:graphics"
  },
  "peerDependenciesMeta": {
    "@nanoforge-dev/editor-lib": {
      "optional": true
    }
  },
  "devDependencies": {
    "@favware/cliff-jumper": "catalog:ci",
    "@nanoforge-dev/editor-lib": "workspace:*",
    "@nanoforge-dev/utils-eslint-config": "workspace:*",
    "@nanoforge-dev/utils-prettier-config": "workspace:*",
    "@trivago/prettier-plugin-sort-imports": "catalog:lint",
    "eslint": "catalog:lint",
    "prettier": "catalog:lint",
    "three": "catalog:graphics",
    "tsdown": "catalog:build",
    "typescript": "catalog:core",
    "unrun": "catalog:build",
    "vitest": "catalog:test"
  },
  "packageManager": "pnpm@12.0.0",
  "engines": {
    "node": "26"
  },
  "publishConfig": {
    "access": "public"
  },
  "lint-staged": {
    "**": [
      "prettier --ignore-unknown --write"
    ],
    "src/**/*.ts": [
      "eslint --fix"
    ]
  }
}
